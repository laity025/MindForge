# ===== MindForge 后端配置（复制为 .env，切勿提交真实 Key） =====
# 大模型 API（OpenAI 兼容，可换 DeepSeek / Qwen 百炼 / SiliconFlow 硅基流动 / Kimi / 混元 等）
# 留空则启用本地 Mock 生成器，无需 Key 也可完整演示
LLM_API_KEY=
# Base URL 需指向各厂商 OpenAI 兼容的 /v1 端点：
#   DeepSeek:           https://api.deepseek.com/v1
#   Qwen 百炼:           https://dashscope.aliyuncs.com/compatible-mode/v1
#   SiliconFlow 硅基流动: https://api.siliconflow.cn/v1  （OpenAI 兼容，托管 DeepSeek/Qwen/GLM 等开源模型）
LLM_BASE_URL=https://api.deepseek.com/v1
# 对话用快模型 / 报告用强模型（留空则用默认值）
#   DeepSeek:        deepseek-chat / deepseek-reasoner
#   Qwen 百炼:        qwen-plus / qwen-max（开发期可用 qwen-flash 等免费档）
#   SiliconFlow:     模型 ID 用「厂商/模型」全名，如 deepseek-ai/DeepSeek-V3、Qwen/Qwen3-32B、
#                    THUDM/GLM-4.5；完整列表见 https://cloud.siliconflow.com/models
#                    注意：FAST_MODEL 建议选非思考型（流式首字快）；STRONG_MODEL 可用 R1 等思考模型，
#                    但思考模型响应慢，若报告频繁超时请调大 TIMEOUT_MS
FAST_MODEL=deepseek-chat
STRONG_MODEL=deepseek-chat

# 超时与上限（非功能门槛）
TIMEOUT_MS=2000
MAX_TURNS=40
MAX_DURATION_MIN=20

# 前端域名（CORS）。* 表示允许全部，生产请改为自有域名
CORS_ORIGINS=*

# 提示：配置后可用「配置弹层 → 测试连接」或 POST /api/config/model/probe 自检连通性
